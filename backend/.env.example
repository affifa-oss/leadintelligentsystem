# Copy to backend/.env and fill in what you need. Everything is optional; sensible defaults apply.

PORT=4000
# Public address of the app (used in email links). Dev: http://localhost:5173
APP_URL=http://localhost:5173
# Firebase Firestore: put the key file at backend/firebase-service-account.json (never commit it),
# or set one of these. Without a key, a local SQLite file is used. DB_DRIVER=sqlite forces SQLite.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/key.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Secret for signing login tokens. Leave empty to auto-generate one (stored in the database).
JWT_SECRET=
# First admin account, created only when the database has no users (password: at least 8 characters).
# Leave empty to create it on the login page instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# Only needed if the frontend is hosted on a different domain than the API.
CORS_ORIGIN=

# ── AI for inquiry summaries & follow-up drafts ───────────────────────────
# Without a key the app uses built-in templates.
# FREE option: Google Gemini. Get a key at https://aistudio.google.com (sign in with Google → "Get API key").
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Paid option: Claude (Anthropic). Used when there is no Gemini key, or when AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_PROVIDER=gemini
# AI_ENABLED=true

# ── Email (follow-up reminders, password reset) ───────────────────────────
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# REMINDER_INTERVAL_MS=300000

# ── Website analysis (Google PageSpeed / Lighthouse) ──────────────────────
# Works without a key on a small shared quota; add a free key for reliable use.
PAGESPEED_API_KEY=
# PAGESPEED_ENABLED=true
