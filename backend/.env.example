# Copy to backend/.env and fill in what you need. Everything is optional; sensible defaults apply.

PORT=4000
# Public address of the app (used in email links). Dev: http://localhost:5173
APP_URL=http://localhost:5173
# Secret for signing login tokens. Leave empty to auto-generate one (stored in the database).
JWT_SECRET=
# Only needed if the frontend is hosted on a different domain than the API.
CORS_ORIGIN=

# ── AI (Claude) for inquiry summaries & follow-up drafts ──────────────────
# Without a key the app uses built-in templates.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_ENABLED=true

# ── Email (follow-up reminders, password reset) ───────────────────────────
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# REMINDER_INTERVAL_MS=300000

# ── Website analysis (Google PageSpeed / Lighthouse) ──────────────────────
# Works without a key on a small shared quota; add a free key for reliable use.
PAGESPEED_API_KEY=
# PAGESPEED_ENABLED=true
